{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qrmystic-links-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-12",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "SCAN_ORIGIN": "http://127.0.0.1:8787",
    "MANAGE_ORIGIN": "http://127.0.0.1:8787",
    "ACCESS_AUDIENCE": "qrmystic-local-pilot",
    "EDITOR_URL": "http://127.0.0.1:5173/qrmagic/"
  },
  "access": {
    "dev": {
      "aud": "qrmystic-local-pilot",
      "identity": { "email": "staff@example.com" }
    }
  },
  "d1_databases": [
    {
      "binding": "LINKS_DB",
      "database_name": "qrmystic-links-local",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "migrations"
    }
  ]
}
