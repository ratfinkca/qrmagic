{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qrmystic-links-pilot",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-12",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "go-pilot.qrmystic.com", "custom_domain": true },
    { "pattern": "manage-pilot.qrmystic.com", "custom_domain": true }
  ],
  "vars": {
    "SCAN_ORIGIN": "https://go-pilot.qrmystic.com",
    "MANAGE_ORIGIN": "https://manage-pilot.qrmystic.com",
    "ACCESS_AUDIENCE": "replace-with-the-management-access-audience"
  },
  "d1_databases": [
    {
      "binding": "LINKS_DB",
      "database_name": "qrmystic-links-pilot",
      "database_id": "replace-with-the-pilot-d1-database-id",
      "migrations_dir": "migrations"
    }
  ]
}
